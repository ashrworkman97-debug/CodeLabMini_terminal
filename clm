def resolve_port(explicit: Optional[str] = None) -> str:
    """Select an explicit port or identify the connected Mini automatically."""
    ports = get_ports()
    if explicit:
        return explicit
    matches = [p for p in ports if p.vid == USB_VID and p.pid == USB_PID]
    if len(matches) == 1:
        return matches[0].device
    if len(matches) > 1:
        print("More than one FTDI 0403:6015 device is connected:")
        for port in matches:
            print(f"  {port.device}")
        raise RuntimeError("Use `clm connect PORT` to choose one (for example COM3 or /dev/cu.usbserial-*).")
    if len(ports) == 1:
        return ports[0].device
    if ports:
        show_devices()
        raise RuntimeError("Couldn't identify the Code Lab Mini. Specify its serial port (for example COM3).")
    raise RuntimeError("No serial ports found. Plug in the Mini and check the USB cable and operating-system permissions.")


def need_link(link: Optional[SerialLink]) -> bool:
    """Return whether a serial link is available, reporting when it is not."""
    if link is None:
        print("Not connected. Use `reconnect` or `scan`.")
        return False
    return True


def send(link: Optional[SerialLink], command: str):
    """Send a command only when the interactive session has an active link."""
    if need_link(link):
        link.send(command)


def parse_int(value: str, low: int, high: int) -> int:
    """Parse an integer and require it to fall within the inclusive bounds."""
    number = int(value)
    if number < low or number > high:
        raise ValueError
    return number


