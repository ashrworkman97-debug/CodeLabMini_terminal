def local_command(cmd: str, args: list[str], started_at: float) -> bool:
    """Handle local-only shell toys. Return True when command was handled."""
    if cmd == "clear":
        print("\033[2J\033[H", end="")
        return True
    if cmd == "ascii":
        terminal_logo()
        return True
    if cmd == "joke":
        print(random.choice(JOKES))
        return True
    if cmd == "fortune":
        print("🔮 " + random.choice(FORTUNES))
        return True
    if cmd == "magic8":
        question = " ".join(args).strip() or "Is this project awesome?"
        print(f"Q: {question}\n🎱 {random.choice(MAGIC_ANSWERS)}")
        return True
    if cmd == "time":
        print(_datetime.datetime.now().astimezone().strftime("%A, %B %d, %Y — %I:%M:%S %p %Z"))
        return True
    if cmd == "uptime":
        seconds = int(time.monotonic() - started_at)
        print(f"CLM-1 has been running for {seconds // 3600}h {(seconds % 3600) // 60}m {seconds % 60}s.")
        return True
    if cmd == "whoami":
        print("System: CLM-1\nHost: Linux\nDevice: Let's Start Coding Code Lab Mini")
        return True
    if cmd == "credits":
        print("CLM-1 Command Line Manager\nHost: Python 3 + pySerial\nFirmware: ATmega328P-compatible Arduino C++\nOptional AI command generation: OpenAI API.")
        return True
    if cmd == "roll":
        try:
            sides = parse_int(args[0], 2, 1_000_000) if args else 6
            count = parse_int(args[1], 1, 30) if len(args) > 1 else 1
            if len(args) > 2:
                raise ValueError
            results = [random.randint(1, sides) for _ in range(count)]
            print(f"🎲 d{sides}: " + ", ".join(map(str, results)))
            if count > 1:
                print(f"Total: {sum(results)}")
        except ValueError:
            print("Usage: roll [sides 2-1000000] [count 1-30]")
        return True
    if cmd == "rps":
        try:
            choice = input("Choose rock, paper, or scissors: ").strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("Cancelled.")
            return True
        if choice not in ("rock", "paper", "scissors"):
            print("That's not rock, paper, or scissors.")
        else:
            cpu = random.choice(("rock", "paper", "scissors"))
            outcome = "It's a tie!" if choice == cpu else (
                "You win!" if (choice, cpu) in (("rock", "scissors"), ("paper", "rock"), ("scissors", "paper")) else "The computer wins!"
            )
            print(f"You: {choice} | CLM: {cpu} — {outcome}")
        return True
    return False


def shell(initial_port: Optional[str] = None) -> int:
    """Run the interactive CLM-1 console and manage its serial connection."""
    print(f"CLM-1 Command Line Manager v{APP_VERSION}")
    print("Type `help` for commands. Type `quit` to exit.\n")
    started_at = time.monotonic()
    check_for_update(APP_VERSION, silent=True)
    link = None
    try:
        port = resolve_port(initial_port)
        link = SerialLink(port)
        print(f"[host] Opened {port} at {DEFAULT_BAUD} baud.")
        time.sleep(0.2)
        link.send("PING")
        link.send("INFO")
    except RuntimeError as exc:
        print(f"[connection] {exc}")
        print("CLM-1 will start offline. Use `scan` and `reconnect` after fixing USB access.")

    led_state = False
    while True:
        if link:
            link.check_reader()
        try:
            line = input("CLM-1> ").strip()
        except (EOFError, KeyboardInterrupt):
            print("\nLeaving CLM-1.")
            break
        if not line:
            continue
        try:
            words = shlex.split(line)
        except ValueError as exc:
            print(f"[syntax] {exc}")
            continue
        cmd = words[0].lower()
        args = words[1:]

        if cmd in ("quit", "exit"):
            break
        if cmd == "update":
            if args and args[0].lower() == "check":
                check_for_update(APP_VERSION, silent=False, force=True)
            elif not args:
                install_update()
            else:
                print("Usage: update [check]")
            continue
        if cmd == "doctor":
            if not args:
                run_doctor()
            elif len(args) == 1 and args[0].lower() == "--json":
                run_doctor(json_output=True)
            else:
                print("Usage: doctor [--json]")
            continue
        if cmd == "ai":
            handle_ai_command(args)
            continue
        if cmd == "clm_h@cker_init":
            previous_port = link.port if link else None
            if link:
                link.close()
                link = None
            flash_code, flash_port = handle_flash_command(args, default_port=previous_port)
            reconnect_port = flash_port or previous_port
            if reconnect_port:
                time.sleep(1.0)
                try:
                    link = SerialLink(reconnect_port)
                    print(f"[host] Reconnected to {reconnect_port}.")
                    time.sleep(0.2)
                    link.send("PING")
                    link.send("INFO")
                except RuntimeError as exc:
                    link = None
                    print(f"[connection] Could not reopen the serial port: {exc}")
            continue
        if cmd == "custom":
            handle_custom_command(args, link)
            continue
        saved_commands = load_commands()
        if cmd in saved_commands:
            if args:
                print(f"Usage: {cmd}  (custom commands do not take arguments)")
            else:
                run_custom_command(saved_commands[cmd], link)
            continue
        if cmd == "run":
            if len(args) == 1:
                handle_custom_command(["run", args[0]], link)
            else:
                print("Usage: run CUSTOM_COMMAND")
            continue
        if local_command(cmd, args, started_at):
            continue
        if cmd in ("help", "?"):
            print_help()
        elif cmd == "version":
            print(f"CLM-1 {APP_VERSION} | firmware protocol CLM1/{FIRMWARE_VERSION} | AI macro builder enabled")
        elif cmd in ("scan", "ports", "devices"):
            try:
                show_devices()
            except SystemExit:
                pass
        elif cmd == "device":
            if link and link.ser.is_open:
                print(f"Connected: {DEVICE_NAME} on {link.port} at {link.baud} baud (FTDI 0403:6015)")
            else:
                print("No active device connection.")
        elif cmd in ("ping", "info", "status", "buttons"):
            send(link, {"ping": "PING", "info": "INFO", "status": "READ", "buttons": "READ"}[cmd])
        elif cmd == "echo":
            if args:
                send(link, "ECHO " + " ".join(args))
            else:
                print("Usage: echo TEXT")
        elif cmd == "led":
            if not args:
                print("Usage: led 1|2|3 [on|off|toggle]  (1 red, 2 green, 3 blue)")
                continue
            names = {"red": "1", "green": "2", "blue": "3"}
            if args[0].lower() in ("on", "off", "toggle"):
                led_number = "1"
                action = args[0].upper()
                if len(args) > 1:
                    print("Usage: led on|off|toggle")
                    continue
            elif args[0].lower() in ("all", "clear"):
                if args[0].lower() == "clear":
                    action = "OFF"
                else:
                    action = args[1].upper() if len(args) > 1 else "ON"
                if action not in ("ON", "OFF"):
                    print("Usage: led all on|off")
                    continue
                send(link, f"LED ALL {action}" if action == "ON" else "RGB 0 0 0")
                continue
            else:
                led_number = names.get(args[0].lower(), args[0])
                if led_number not in ("1", "2", "3"):
                    print("LEDs: 1/red, 2/green, 3/blue")
                    continue
                action = args[1].upper() if len(args) > 1 else "ON"
                if len(args) > 2 or action not in ("ON", "OFF", "TOGGLE"):
                    print("Usage: led 1|2|3 [on|off|toggle]")
                    continue
            if need_link(link):
                if link.send(f"LED {led_number} {action}") and led_number == "1":
                    led_state = action == "ON" if action != "TOGGLE" else not led_state
        elif cmd in ("color", "colour"):
            if len(args) != 1:
                print("Usage: color off|red|green|blue|yellow|cyan|magenta|white")
            else:
                send(link, f"COLOR {args[0].upper()}")
        elif cmd == "rgb":
            if len(args) != 3 or any(value not in ("0", "1") for value in args):
                print("Usage: rgb R G B  (each channel is 0 or 1; e.g. rgb 1 0 1)")
            else:
                send(link, "RGB " + " ".join(args))
        elif cmd == "blink":
            try:
                if not args:
                    led_num, count, ms = 1, 3, 200
                elif len(args) == 2:
                    led_num, count, ms = 1, parse_int(args[0], 1, 30), parse_int(args[1], 30, 2000)
                elif len(args) == 3:
                    led_num, count, ms = parse_int(args[0], 1, 3), parse_int(args[1], 1, 30), parse_int(args[2], 30, 2000)
                else:
                    raise ValueError
                send(link, f"BLINK {led_num} {count} {ms}")
            except ValueError:
                print("Usage: blink [LED 1-3] [count 1-30] [ms 30-2000]")
        elif cmd in ("chase", "wave", "rainbow"):
            try:
                cycles = parse_int(args[0], 1, 20) if args else (1 if cmd == "rainbow" else 2)
                ms = parse_int(args[1], 30, 1500) if len(args) > 1 else 120
                if len(args) > 2:
                    raise ValueError
                send(link, f"{cmd.upper()} {cycles} {ms}")
            except ValueError:
                print(f"Usage: {cmd} [cycles 1-20] [step-ms 30-1500]")
        elif cmd in ("party", "siren", "alarm", "heartbeat", "countdown"):
            try:
                limits = {"party": (1, 10, 5), "siren": (1, 20, 3), "alarm": (1, 20, 3), "heartbeat": (1, 20, 2), "countdown": (1, 10, 3)}
                low, high, default = limits[cmd]
                amount = parse_int(args[0], low, high) if args else default
                if len(args) > 1:
                    raise ValueError
                send(link, f"{cmd.upper()} {amount}")
            except ValueError:
                print(f"Usage: {cmd} [{limits[cmd][0]}-{limits[cmd][1]}]")
        elif cmd in ("laser", "powerup", "explosion", "melody", "demo", "random", "dice", "coin", "ledtest", "glitch", "portal", "hyperspace"):
            if args:
                print(f"Usage: {cmd}")
            elif cmd == "demo":
                for action in ("POWERUP", "CHASE 2 100", "MELODY", "HEARTBEAT 1"):
                    if not link or not link.send(action):
                        break
                    if action.startswith("POWERUP"):
                        time.sleep(1.7)
                    elif action.startswith("CHASE"):
                        time.sleep(0.8)
                    elif action.startswith("MELODY"):
                        time.sleep(1.8)
                    else:
                        time.sleep(0.9)
            else:
                send(link, cmd.upper())
        elif cmd in ("beacon", "fireworks"):
            try:
                maximum = 20 if cmd == "beacon" else 10
                default = 3
                amount = parse_int(args[0], 1, maximum) if args else default
                if len(args) > 1:
                    raise ValueError
                send(link, f"{cmd.upper()} {amount}")
            except ValueError:
                print(f"Usage: {cmd} [count 1-{maximum}]")
        elif cmd in ("beep", "tone"):
            try:
                hz = parse_int(args[0], 40, 10000) if args else 700
                if cmd == "beep":
                    ms = parse_int(args[1], 1, 5000) if len(args) > 1 else 300
                    if len(args) > 2:
                        raise ValueError
                    send(link, f"BEEP {hz} {ms}")
                else:
                    if len(args) > 1:
                        raise ValueError
                    send(link, f"TONE {hz}")
            except ValueError:
                print("Usage: beep [Hz 40-10000] [ms 1-5000] | tone [Hz 40-10000]")
        elif cmd in ("motor", "buzz"):
            try:
                if args and args[0].lower() == "off":
                    if len(args) > 1:
                        raise ValueError
                    send(link, "MOTOR OFF")
                else:
                    strength = parse_int(args[0], 0, 255) if args else 180
                    ms = parse_int(args[1], 1, 5000) if len(args) > 1 else 350
                    if len(args) > 2:
                        raise ValueError
                    send(link, f"MOTOR {strength} {ms}")
            except ValueError:
                print("Usage: motor|buzz [strength 0-255] [ms 1-5000] or motor off")
        elif cmd == "pulse":
            try:
                values = [3, 180, 100, 120]
                for index, pair in enumerate(((1, 20), (2, 255), (3, 1000), (4, 1000))):
                    if len(args) >= index + 1:
                        values[index] = parse_int(args[index], pair[0], pair[1])
                if len(args) > 4:
                    raise ValueError
                send(link, "PULSE " + " ".join(map(str, values)))
            except ValueError:
                print("Usage: pulse [count 1-20] [strength 1-255] [on-ms 20-1000] [off-ms 20-1000]")
        elif cmd == "knob":
            if len(args) == 0:
                send(link, "READ")
            elif len(args) == 1 and args[0].lower() in ("tone", "motor", "color", "off"):
                send(link, f"KNOB {args[0].upper()}")
            else:
                print("Usage: knob tone|motor|color|off")
        elif cmd == "stop":
            send(link, "STOP")
        elif cmd in ("reset", "panic"):
            send(link, "RESET")
        elif cmd == "stream":
            if len(args) == 1 and args[0].lower() in ("on", "off"):
                send(link, "STREAM " + args[0].upper())
            else:
                print("Usage: stream on|off")
        elif cmd == "sos":
            if need_link(link):
                link.send_morse("SOS")
        elif cmd == "morse":
            if need_link(link) and args:
                link.send_morse(" ".join(args))
            elif not args:
                print("Usage: morse TEXT")
        elif cmd == "reconnect":
            if link:
                link.close()
                link = None
            try:
                port = resolve_port(initial_port)
                link = SerialLink(port)
                print(f"[host] Reconnected to {port}.")
                time.sleep(0.2)
                link.send("PING")
                link.send("INFO")
            except RuntimeError as exc:
                print(f"[connection] {exc}")
        else:
            print(f"Unknown command: {cmd}. Type `help`.")

    if link:
        link.send("RESET")
        link.close()
    print("CLM-1 closed.")
    return 0


def main(argv=None) -> int:
    """Dispatch a top-level CLM-1 command and return its process exit code."""
    args = list(sys.argv[1:] if argv is None else argv)
    if not args:
        return shell()
    first = args[0].lower()
    if first in ("-h", "--help", "help"):
        print("Usage: clm [command]\n\n  clm                  Start interactive CLM-1 console\n  clm device clm       Connect to the Code Lab Mini and start console\n  clm device           List/identify devices\n  clm scan             Scan serial ports\n  clm connect [PORT]   Connect using a specified serial port\n  clm_h@cker_init     Compile and flash bundled firmware\n  clm_h@cker_init --compile-only  Compile without uploading\n  clm --version        Show version\n  clm update           Download and install the latest host update\n  clm update check     Check GitHub for a newer version\n  clm doctor [--json]  Diagnose local setup and USB access (read-only)\n  clm ai setup         Configure an OpenAI API key\n  clm ai create IDEA   Generate and save a custom command\n  clm custom list      List saved custom commands\n")
        return 0
    if first == "doctor":
        if len(args) > 2 or (len(args) == 2 and args[1].lower() != "--json"):
            print("Usage: clm doctor [--json]")
            return 2
        return run_doctor(json_output=len(args) == 2)
    if first == "update":
        if len(args) == 2 and args[1].lower() == "check":
            check_for_update(APP_VERSION, silent=False, force=True)
            return 0
        if len(args) == 1:
            return install_update()
        print("Usage: clm update [check]")
        return 2
    if first in ("-v", "--version", "version"):
        print(f"CLM-1 {APP_VERSION}")
        return 0
    if first == "clm_h@cker_init":
        flash_code, _ = handle_flash_command(args[1:])
        return flash_code
    if first == "ai":
        handle_ai_command(args[1:])
        return 0
    if first == "custom":
        handle_custom_command(args[1:], None)
        return 0
    if first in ("scan", "devices", "ports"):
        return show_devices()
    if first == "device":
        if len(args) == 1:
            return show_devices()
        if len(args) >= 2 and args[1].lower() in ("clm", "mini", "code-lab-mini"):
            return shell()
        if len(args) >= 2 and args[1].lower() not in ("clm", "mini", "code-lab-mini"):
            return shell(args[1])
        print("Usage: clm device [clm|PORT]")
        return 2
    if first in ("connect", "shell"):
        return shell(args[1] if len(args) > 1 else None)
    print(f"Unknown CLM-1 command: {first}. Run `clm --help`.")
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
