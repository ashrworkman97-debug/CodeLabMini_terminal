def run_doctor(json_output: bool = False) -> int:
    """Run setup diagnostics while remaining compatible with 1.6.0 self-updates."""
    try:
        from clm_doctor import run_doctor as doctor
    except ModuleNotFoundError as exc:
        if exc.name != "clm_doctor":
            raise
        message = (
            "The diagnostics module is missing from this installation. "
            "Run `clm update` once more to finish the CLM-1 upgrade, then retry."
        )
        if json_output:
            print(json.dumps({
                "schema_version": 1,
                "checks": [{"status": "FAIL", "name": "Diagnostics module", "detail": message}],
                "summary": {"ok": 0, "warn": 0, "info": 0, "fail": 1},
                "exit_code": 1,
            }, indent=2))
        else:
            print(f"[doctor] {message}")
        return 1
    return doctor(json_output=json_output)

