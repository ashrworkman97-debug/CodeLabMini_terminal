def load_serial_modules():
    """Import pySerial and show installation guidance when it is unavailable."""
    try:
        import serial
        from serial.tools import list_ports
        return serial, list_ports
    except ImportError:
        print("CLM-1 needs pyserial. Install it with:", file=sys.stderr)
        print("  python -m pip install pyserial", file=sys.stderr)
        raise SystemExit(2)


def get_ports():
    """Return the serial ports currently visible to pySerial."""
    _, list_ports = load_serial_modules()
    return list(list_ports.comports())


def show_devices() -> int:
    """List visible serial devices and report whether a Code Lab Mini was found."""
    ports = get_ports()
    print("CLM-1 device scan")
    print("-----------------")
    if not ports:
        print("No serial ports found.")
        print("In ChromeOS, share the FTDI USB device with Linux in Settings → Developers → Linux USB preferences.")
        return 1
    matched = False
    for port in ports:
        vid = port.vid if port.vid is not None else -1
        pid = port.pid if port.pid is not None else -1
        is_clm = (vid, pid) == (USB_VID, USB_PID)
        matched |= is_clm
        tag = "  <--- Code Lab Mini (FTDI)" if is_clm else ""
        print(f"{port.device:16} {port.description or 'Serial device'}  VID:PID={vid:04x}:{pid:04x}{tag}")
    if not matched:
        print("\nNo 0403:6015 FTDI device detected. Is it plugged in and shared with Linux?")
    return 0 if matched else 1


class SerialLink:
    def __init__(self, port: str, baud: int = DEFAULT_BAUD):
        """Open the selected serial port and start its background reader."""
        serial, _ = load_serial_modules()
        self.serial_module = serial
        self.port = port
        self.baud = baud
        self.ser = serial.Serial()
        self.ser.port = port
        self.ser.baudrate = baud
        self.ser.timeout = 0.2
        self.ser.write_timeout = 1.0
        self.ser.xonxoff = False
        self.ser.rtscts = False
        self.ser.dsrdtr = False
        self.ser.dtr = False
        self.ser.rts = False
        self.reader_stop = threading.Event()
        self.reader_error: queue.Queue[str] = queue.Queue()
        self.last_state = None
        self.write_lock = threading.Lock()
        self.reader = None
        self.open()

    def explain_serial_error(self, exc: Exception) -> str:
        """Turn a serial exception into actionable platform-specific guidance."""
        message = str(exc)
        lower = message.lower()
        if "input/output error" in lower or "errno 5" in lower:
            return (
                f"USB serial I/O error on {self.port}: {message}\n"
                "Linux lost access to the USB serial interface. Unplug/replug the Mini, "
                "share it with Linux again in ChromeOS USB preferences, and close the "
                "manufacturer's editor/Serial Monitor before retrying."
            )
        if "permission" in lower or "access is denied" in lower:
            return (
                f"Permission denied opening {self.port}: {message}\n"
                "Try `sudo usermod -aG dialout $USER`, then restart the Linux container."
            )
        return f"Serial error on {self.port}: {message}"

    def open(self):
        """Open the configured serial port and start the reader thread."""
        try:
            self.ser.open()
        except (OSError, self.serial_module.SerialException) as exc:
            raise RuntimeError(self.explain_serial_error(exc)) from exc
        self.reader = threading.Thread(target=self.read_loop, daemon=True)
        self.reader.start()

    def send(self, command: str) -> bool:
        """Write one newline-terminated ASCII command to the Mini."""
        try:
            payload = (command.strip() + "\n").encode("ascii", errors="strict")
        except UnicodeEncodeError:
            print("[error] Device commands must use plain ASCII characters.")
            return False
        if not self.ser.is_open:
            print("[error] Serial port is closed. Use `reconnect`.")
            return False
        try:
            with self.write_lock:
                self.ser.write(payload)
                self.ser.flush()
            return True
        except (OSError, self.serial_module.SerialException) as exc:
            print("\n[USB ERROR] " + self.explain_serial_error(exc))
            return False

    def read_loop(self):
        """Read device messages and report state changes until stopped or disconnected."""
        while not self.reader_stop.is_set():
            try:
                raw = self.ser.readline()
            except (OSError, self.serial_module.SerialException) as exc:
                if not self.reader_stop.is_set():
                    self.reader_error.put(self.explain_serial_error(exc))
                return
            if not raw:
                continue
            line = raw.decode("utf-8", errors="replace").strip()
            if not line:
                continue
            if line.startswith("STATE "):
                parts = line.split()
                if len(parts) == 6:
                    try:
                        state = tuple(int(value) for value in parts[1:])
                    except ValueError:
                        print(f"\n[device] {line}")
                        continue
                    if state != self.last_state:
                        self.last_state = state
                        a, b, left, right, knob = state
                        print(f"\n[input] A={a} B={b} LEFT={left} RIGHT={right} KNOB={knob}")
                continue
            print(f"\n[device] {line}")

    def check_reader(self):
        """Display any serial-reader error deferred by the background thread."""
        try:
            message = self.reader_error.get_nowait()
        except queue.Empty:
            return
        print("\n[USB ERROR] " + message)

    def close(self):
        """Stop the reader thread and close the serial port when it is open."""
        self.reader_stop.set()
        if self.reader and self.reader.is_alive():
            self.reader.join(timeout=0.8)
        try:
            if self.ser.is_open:
                self.ser.close()
        except Exception:
            pass

    def send_morse(self, message: str, unit_ms: int = 120, frequency: int = 700):
        """Transmit a message as Morse code through the Mini's speaker."""
        text = message.upper()
        unsupported = sorted(set(ch for ch in text if ch != " " and ch not in MORSE))
        if unsupported:
            print("Unsupported characters skipped: " + " ".join(unsupported))
        words = [word for word in text.split() if word]
        if not words:
            print("Nothing to transmit. Use A-Z, digits 0-9, and spaces.")
            return
        for word_index, word in enumerate(words):
            letters = [ch for ch in word if ch in MORSE]
            for letter_index, char in enumerate(letters):
                pattern = MORSE[char]
                for symbol_index, symbol in enumerate(pattern):
                    duration = unit_ms if symbol == "." else unit_ms * 3
                    if not self.send(f"BEEP {frequency} {duration}"):
                        return
                    time.sleep(duration / 1000)
                    if symbol_index < len(pattern) - 1:
                        time.sleep(unit_ms / 1000)
                if letter_index < len(letters) - 1:
                    time.sleep(3 * unit_ms / 1000)
            if word_index < len(words) - 1:
                time.sleep(7 * unit_ms / 1000)
        self.send("STOP")


